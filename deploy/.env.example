# Hostnames: the user-content host MUST be a different registrable domain (e.g. example-usercontent.net).
OC_APP_HOST=design.example.com
OC_USERCONTENT_HOST=example-usercontent.net
OC_ACME_EMAIL=ops@example.com

# Long random values: openssl rand -base64 48
OC_SECRET=
POSTGRES_PASSWORD=

# Comma-separated emails that get the staff console.
OC_STAFF_EMAILS=
# Who can create an account: open, or invite for only OC_SIGNUP_ALLOW, OC_STAFF_EMAILS and people with a pending team
# invite. Existing accounts always keep signing in.
OC_SIGNUP=open
# With invite: comma-separated emails and @domain entries, e.g. ana@example.com,@example.org
OC_SIGNUP_ALLOW=

# Email (required for magic links, invites, resets). Example: smtps://user:pass@smtp.example.com:465
OC_SMTP_URL=
OC_MAIL_FROM=Pinselo <no-reply@design.example.com>

# Object storage (S3, R2, MinIO). Leave OC_S3_BUCKET empty to store files on the data volume.
OC_S3_BUCKET=
OC_S3_REGION=auto
OC_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Sign-in providers (optional).
OC_GOOGLE_CLIENT_ID=
OC_GOOGLE_CLIENT_SECRET=
OC_APPLE_CLIENT_ID=
OC_APPLE_CLIENT_SECRET=
OC_OIDC_ISSUER=
OC_OIDC_CLIENT_ID=
OC_OIDC_CLIENT_SECRET=
OC_OIDC_LABEL=SSO

# ---------------------------------------------------------------- Supabase (optional, docs/supabase.md)
# Leave everything below commented out to keep the bundled Postgres, local files and the built-in sign-in.
#
# Database on Supabase. Use the session pooler (port 5432, user postgres.<ref>) or a direct connection
# (db.<ref>.supabase.co, IPv6 or the IPv4 add-on). Never the transaction pooler on port 6543: it is refused.
# OC_DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The Supabase CA (Dashboard → Database Settings → SSL Configuration), mounted into the containers (see docker-compose.yml).
# OC_DATABASE_SSL_CA=/run/secrets/supabase-ca.crt
# Connections per service; every service shares the project's Pool Size in session mode.
# OC_DATABASE_POOL_MAX=4
#
# Supabase Auth: on only when both OC_SUPABASE_URL and OC_SUPABASE_PUBLISHABLE_KEY are set.
# Empty OC_SUPABASE_URL = the built-in sign-in (passwords, magic links, passkeys, Google/Apple/SSO above).
# OC_SUPABASE_URL=https://<ref>.supabase.co
# The publishable key is sent to browsers; never put the secret key here.
# OC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…
# Server-only, used to delete Supabase users when an account is deleted. Required in production with Supabase Auth.
# OC_SUPABASE_SECRET_KEY=sb_secret_…
# Legacy only: the HS256 JWT secret, while the project still signs tokens with it (prefer asymmetric signing keys).
# OC_SUPABASE_JWT_SECRET=
# Only for a custom auth domain; default https://<ref>.supabase.co/auth/v1.
# OC_SUPABASE_JWT_ISSUER=
#
# Supabase Storage through its S3 endpoint (a private bucket; these keys bypass RLS and reach every bucket).
# OC_S3_BUCKET=opencanvas
# OC_S3_REGION=<region>
# OC_S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Supabase Storage does not take the SHA-256 upload checksums Pinselo sends by default.
# OC_S3_CHECKSUMS=off
