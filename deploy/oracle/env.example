# The Oracle server's settings (docs/deploy-oracle.md). Copy to .env next to compose.yml: cp env.example .env
# Never commit the filled-in file.

# ---------------------------------------------------------------- Hostnames
OC_APP_HOST=design.example.com
# For the HTTPS certificates (Let's Encrypt notices only).
OC_ACME_EMAIL=you@example.com

# ---------------------------------------------------------------- Secrets
# A long random value: openssl rand -base64 48
OC_SECRET=
# Comma-separated emails that get the staff console.
OC_STAFF_EMAILS=
# Who can create an account: open, or invite for only OC_SIGNUP_ALLOW, OC_STAFF_EMAILS and people with a pending team
# invite. Existing accounts always keep signing in.
OC_SIGNUP=open
# With invite: comma-separated emails and @domain entries, e.g. ana@example.com,@example.org
OC_SIGNUP_ALLOW=

# ---------------------------------------------------------------- Email (sign-in links, invites, password resets)
# From your email provider's SMTP settings, e.g. smtps://user:pass@smtp.example.com:465
OC_SMTP_URL=
OC_MAIL_FROM=Pinselo <no-reply@design.example.com>

# ---------------------------------------------------------------- Supabase database (docs/supabase.md)
# Dashboard → Connect → Session pooler (port 5432, user postgres.<ref>). Never port 6543.
# Percent-encode special characters in the password.
OC_DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Connections per service, plus one listener each. Four services and the migrator share the project's pool
# (15 on the free plan): 4 × (2 + 1) = 12.
OC_DATABASE_POOL_MAX=2
# The CA certificate is mounted from ./supabase-ca.crt (compose.yml sets OC_DATABASE_SSL_CA).

# ---------------------------------------------------------------- Supabase Storage (a private bucket)
# Dashboard → Storage → S3 Configuration. These keys reach every bucket: keep them on the server only.
OC_S3_BUCKET=opencanvas
OC_S3_REGION=
OC_S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OC_S3_CHECKSUMS=off

# ---------------------------------------------------------------- Supabase Auth (optional)
# Leave empty: Pinselo's own sign-in. Uploads share the app host here, and Supabase Auth keeps its tokens in that
# host's browser storage, so do not turn it on without a separate uploads domain (docs/supabase.md).
OC_SUPABASE_URL=
OC_SUPABASE_PUBLISHABLE_KEY=
OC_SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- Sign-in providers (optional)
OC_GOOGLE_CLIENT_ID=
OC_GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Off-site backups (backup.sh, optional)
# An S3-compatible bucket off this server, e.g. Oracle's free Object Storage (Storage -> Buckets; keys from
# Profile -> Customer secret keys). Empty: backups stay on this server only.
OC_BACKUP_S3_BUCKET=pinselo-backups
OC_BACKUP_S3_REGION=eu-frankfurt-1
OC_BACKUP_S3_ENDPOINT=https://<namespace>.compat.objectstorage.eu-frankfurt-1.oraclecloud.com
OC_BACKUP_S3_ACCESS_KEY_ID=
OC_BACKUP_S3_SECRET_ACCESS_KEY=
