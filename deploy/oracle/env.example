# The Oracle server's settings (docs/deploy-oracle.md). Copy to .env next to compose.yml: cp env.example .env
# Never commit the filled-in file.

# ---------------------------------------------------------------- Hostnames
OC_APP_HOST=design.example.com
# For the HTTPS certificates (Let's Encrypt notices only).
OC_ACME_EMAIL=you@example.com

# ---------------------------------------------------------------- Secrets
# A long random value: openssl rand -base64 48
OC_SECRET=
# Comma-separated emails that get the staff console.
OC_STAFF_EMAILS=
# Who can create an account: open, or invite for only OC_SIGNUP_ALLOW, OC_STAFF_EMAILS and people with a pending team
# invite. Existing accounts always keep signing in.
OC_SIGNUP=open
# With invite: comma-separated emails and @domain entries, e.g. ana@example.com,@example.org
OC_SIGNUP_ALLOW=

# ---------------------------------------------------------------- Email (sign-in links, invites, password resets)
# From your email provider's SMTP settings, e.g. smtps://user:pass@smtp.example.com:465
OC_SMTP_URL=
OC_MAIL_FROM=Pinselo <no-reply@design.example.com>

# ---------------------------------------------------------------- Database
# The server's own Postgres. Password: openssl rand -hex 32 (it goes into the URL unencoded, so hex only).
POSTGRES_PASSWORD=
OC_DATABASE_URL=postgres://oc:<POSTGRES_PASSWORD>@db:5432/opencanvas
# Connections per service, plus one listener each.
OC_DATABASE_POOL_MAX=10
# Or a Supabase database (docs/supabase.md): Dashboard → Connect → Session pooler (port 5432, user postgres.<ref>),
# never port 6543. Percent-encode special characters in the password. The project's pool is small (15 on the free
# plan), so with OC_DATABASE_POOL_MAX=2: 4 × (2 + 1) = 12.
# OC_DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# OC_DATABASE_POOL_MAX=2
# OC_DATABASE_SSL_CA=/run/secrets/supabase-ca.crt

# ---------------------------------------------------------------- Supabase Storage (a private bucket)
# Dashboard → Storage → S3 Configuration. These keys reach every bucket: keep them on the server only.
OC_S3_BUCKET=opencanvas
OC_S3_REGION=
OC_S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OC_S3_CHECKSUMS=off

# ---------------------------------------------------------------- Supabase Auth (optional)
# Leave empty: Pinselo's own sign-in. Uploads share the app host here, and Supabase Auth keeps its tokens in that
# host's browser storage, so do not turn it on without a separate uploads domain (docs/supabase.md).
OC_SUPABASE_URL=
OC_SUPABASE_PUBLISHABLE_KEY=
OC_SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- Sign-in providers (optional)
OC_GOOGLE_CLIENT_ID=
OC_GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Off-site backups (backup.sh)
# Two private S3-compatible buckets at two different providers (docs/deploy-oracle.md). A run fails unless both hold
# the backup.
# Public key from age-keygen. The private key stays off this server.
OC_BACKUP_AGE_RECIPIENT=
# Monitor that alerts when a run fails or does not happen, e.g. https://hc-ping.com/<uuid> (healthchecks.io).
OC_BACKUP_PING_URL=
# First location, e.g. Cloudflare R2: region auto, endpoint https://<account>.eu.r2.cloudflarestorage.com
OC_BACKUP_S3_BUCKET=
OC_BACKUP_S3_REGION=
OC_BACKUP_S3_ENDPOINT=
OC_BACKUP_S3_ACCESS_KEY_ID=
OC_BACKUP_S3_SECRET_ACCESS_KEY=
# Second location, e.g. Oracle's free Object Storage (Storage -> Buckets; keys from Profile -> Customer secret keys):
# region eu-frankfurt-1, endpoint https://<namespace>.compat.objectstorage.eu-frankfurt-1.oraclecloud.com
OC_BACKUP2_S3_BUCKET=
OC_BACKUP2_S3_REGION=
OC_BACKUP2_S3_ENDPOINT=
OC_BACKUP2_S3_ACCESS_KEY_ID=
OC_BACKUP2_S3_SECRET_ACCESS_KEY=
