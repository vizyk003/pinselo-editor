d":"VQT06OZv50i4yX0C","type":"text","parentId":"wdBpf5PIpiAh3O5D","z":"a0007","opacity":1,"xf":{"x":64,"y":228,"w":360,"h":77.5,"rot":0},"frame":{"mode":"autoHeight"},"autoFit":"none","body":{"paragraphs":[{"align":"start","lineHeight":1.55,"spaceAfter":0,"runs":[{"text":"Ms. Anouk de Vries","style":{}}]},{"align":"start","lineHeight":1.55,"spaceAfter":0,"runs":[{"text":"Head of Public Space","style":{}}]},{"align":"start","lineHeight":1.55,"spaceAfter":0,"runs":[{"text":"Municipality of Westerhaven","style":{}}]},{"align":"start","lineHeight":1.55,"spaceAfter":0,"runs":[{"text":"Stationsplein 1, Westerhaven","style":{}}]}],"defaultRun":{"family":"Inter","weight":400,"italic":false,"size":12.5,"fill":{"k":"solid","color":{"space":"srgb","r":0.16862745098039217,"g":0.16862745098039217,"b":0.16862745098039217,"a":1}},"tracking":0}}},"1P3n9cIjihmib8pl":{"id":"1P3n9cIjihmib8pl","type":"text","parentId":"wdBpf5PIpiAh3O5D","z":"a0008","opacity":1,"xf":{"x":64,"y":340,"w":666,"h":16.25,"rot":0},"frame":{"mode":"autoHeight"},"autoFit":"none","body":{"paragraphs":[{"align":"start","lineHeight":1.3,"spaceAfter":0,"runs":[{"text":"Re: Harbour Park design competition — shortlist submission","style":{}}]}],"defaultRun":{"family":"Inter","weight":700,"italic":false,"size":12.5,"fill":{"k":"solid","color":{"space":"srgb","r":0.10980392156862745,"g":0.10980392156862745,"b":0.10980392156862745,"a":1}},"tracking":0}}},"bkbVJqBP0gpsWs6n":{"id":"bkbVJqBP0gpsWs6n","type":"text","parentId":"wdBpf5PIpiAh3O5D","z":"a0009","opacity":1,"xf":{"x":64,"y":380,"w":666,"h":180,"rot":0},"role":"body","frame":{"mode":"autoHeight"},"autoFit":"none","body":{"paragraphs":[{"align":"start","lineHeight":1.6,"spaceAfter":0,"runs":[{"text":"Dear Ms. de Vries,","style":{}}]},{"align":"start","lineHeight":1.6,"spaceAfter":0,"runs":[]},{"align":"start","lineHeight":1.6,"spaceAfter":0,"runs":[{"text":"Thank you for inviting Fieldwork to the second stage of the Harbour Park competition. Please find enclosed our concept boards, planting strategy and preliminary cost plan.","style":{}}]},{"align":"start","lineHeight":1.6,"spaceAfter":0,"runs":[]},{"align":"start","lineHeight":1.6,"spaceAfter":0,"runs":[{"text":"Our proposal treats the park as a working landscape: a tidal garden that floods and drains with the river, shaded promenades that link the new housing to the ferry stop, and a play meadow designed with children from the neighbouring school. We have paid particular attention to maintenance, using robust native planting and reclaimed harbour stone throughout.","style":{}}]},{"align":"start","lineHeight":1.6,"spaceAfter":0,"runs":[]},{"align":"start","lineHeight":1.6,"spaceAfter":0,"runs":[{"text":"We would welcome the chance to present the scheme in person and to walk the site with your team. I can be reached directly at the number above.","style":{}}]},{"align":"start","lineHeight":1.6,"spaceAfter":0,"runs":[]},{"align":"start","lineHeight":1.6,"spaceAfter":0,"runs":[{"text":"Kind regards,","style":{}}]}],"defaultRun":{"family":"Inter","weight":400,"italic":false,"size":12.5,"fill":{"k":"solid","color":{"space":"srgb","r":0.16862745098039217,"g":0.16862745098039217,"b":0.16862745098039217,"a":1}},"tracking":0}}},"IUJ6TfbBKyMD2Jld":{"id":"IUJ6TfbBKyMD2Jld","type":"text","parentId":"wdBpf5PIpiAh3O5D","z":"a0010","opacity":1,"xf":{"x":64,"y":740,"w":300,"h":16.25,"rot":0},"frame":{"mode":"autoHeight"},"autoFit":"none","body":{"paragraphs":[{"align":"start","lineHeight":1.3,"spaceAfter":0,"runs":[{"text":"Sanne Verbeek","style":{}}]}],"defaultRun":{"family":"Inter","weight":700,"italic":false,"size":12.5,"fill":{"k":"solid","color":{"space":"srgb","r":0.10980392156862745,"g":0.10980392156862745,"b":0.10980392156862745,"a":1}},"tracking":0}}},"7DSMVZ1B9ZtILSsw":{"id":"7DSMVZ1B9ZtILSsw","type":"text","parentId":"wdBpf5PIpiAh3O5D","z":"a0011","opacity":1,"xf":{"x":64,"y":760,"w":300,"h":15.600000000000001,"rot":0},"frame":{"mode":"autoHeight"},"autoFit":"none","body":{"para