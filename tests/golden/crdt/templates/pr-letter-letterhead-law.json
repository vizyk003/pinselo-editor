K58p1aX0","type":"text","parentId":"RUUR7pm7SDdHz75N","z":"a0007","opacity":1,"xf":{"x":72,"y":240,"w":360,"h":84,"rot":0},"frame":{"mode":"autoHeight"},"autoFit":"none","body":{"paragraphs":[{"align":"start","lineHeight":1.4,"spaceAfter":0,"runs":[{"text":"Mr. Thomas Reilly","style":{}}]},{"align":"start","lineHeight":1.4,"spaceAfter":0,"runs":[{"text":"Reilly Family Bakery, LLC","style":{}}]},{"align":"start","lineHeight":1.4,"spaceAfter":0,"runs":[{"text":"44 Spruce Avenue","style":{}}]},{"align":"start","lineHeight":1.4,"spaceAfter":0,"runs":[{"text":"Camden, NJ 08102","style":{}}]}],"defaultRun":{"family":"Cormorant Garamond","weight":500,"italic":false,"size":15,"fill":{"k":"solid","color":{"space":"srgb","r":0.12156862745098039,"g":0.1450980392156863,"b":0.18823529411764706,"a":1}},"tracking":0}}},"1drMbnsX1wFtTt2t":{"id":"1drMbnsX1wFtTt2t","type":"text","parentId":"RUUR7pm7SDdHz75N","z":"a0008","opacity":1,"xf":{"x":72,"y":350,"w":672,"h":19.5,"rot":0},"frame":{"mode":"autoHeight"},"autoFit":"none","body":{"paragraphs":[{"align":"start","lineHeight":1.3,"spaceAfter":0,"runs":[{"text":"Re: Commercial lease renewal — 44 Spruce Avenue","style":{}}]}],"defaultRun":{"family":"Cormorant Garamond","weight":700,"italic":false,"size":15,"fill":{"k":"solid","color":{"space":"srgb","r":0.12156862745098039,"g":0.1450980392156863,"b":0.18823529411764706,"a":1}},"tracking":0}}},"C2dwYXCTR2Km5FGU":{"id":"C2dwYXCTR2Km5FGU","type":"text","parentId":"RUUR7pm7SDdHz75N","z":"a0009","opacity":1,"xf":{"x":72,"y":392,"w":672,"h":202.5,"rot":0},"role":"body","frame":{"mode":"autoHeight"},"autoFit":"none","body":{"paragraphs":[{"align":"start","lineHeight":1.5,"spaceAfter":0,"runs":[{"text":"Dear Mr. Reilly,","style":{}}]},{"align":"start","lineHeight":1.5,"spaceAfter":0,"runs":[]},{"align":"start","lineHeight":1.5,"spaceAfter":0,"runs":[{"text":"Thank you for meeting with us last week. As discussed, we have reviewed the proposed five-year renewal of your lease and have prepared a summary of recommended changes, enclosed with this letter.","style":{}}]},{"align":"start","lineHeight":1.5,"spaceAfter":0,"runs":[]},{"align":"start","lineHeight":1.5,"spaceAfter":0,"runs":[{"text":"In brief, we recommend capping annual rent increases at three percent, clarifying responsibility for roof and HVAC repairs, and adding a renewal option for a further five years on the same terms. We believe the landlord is likely to accept these points.","style":{}}]},{"align":"start","lineHeight":1.5,"spaceAfter":0,"runs":[]},{"align":"start","lineHeight":1.5,"spaceAfter":0,"runs":[{"text":"Please review the summary at your convenience. We would be glad to discuss any questions by phone, or to meet again before we respond to the landlord’s counsel on October 20.","style":{}}]},{"align":"start","lineHeight":1.5,"spaceAfter":0,"runs":[]},{"align":"start","lineHeight":1.5,"spaceAfter":0,"runs":[{"text":"Sincerely,","style":{}}]}],"defaultRun":{"family":"Cormorant Garamond","weight":500,"italic":false,"size":15,"fill":{"k":"solid","color":{"space":"srgb","r":0.12156862745098039,"g":0.1450980392156863,"b":0.18823529411764706,"a":1}},"tracking":0}}},"2i2EwW1hklAXVP7d":{"id":"2i2EwW1hklAXVP7d","type":"text","parentId":"RUUR7pm7SDdHz75N","z":"a0010","opacity":1,"xf":{"x":72,"y":812,"w":300,"h":19.5,"rot":0},"frame":{"mode":"autoHeight"},"autoFit":"none","body":{"paragraphs":[{"align":"start","lineHeight":1.3,"spaceAfter":0,"runs":[{"text":"Catherine Park","style":{}}]}],"defaultRun":{"family":"Cormorant Garamond","weight":700,"italic":false,"size":15,"fill":{"k":"solid","color":{"space":"srgb","r":0.12156862745098039,"g":0.1450980392156863,"b":0.18823529411764706,"a":1}},"tracking":0}}},"J312rsmE3raLtexw":{"id":"J312rsmE3raLtexw","type":"text","parentId":"RUUR7pm7SDdHz75N","z":"a0011","opacity":1,"xf":{"x":72,"y":834,"w":300,"h":18.2,"rot":0},"frame":{"mode":"autoHeight"},"autoFit":"none","body":{"paragraphs":[{"align":"start","lineHeight":1.3,"spaceAfter":0,"runs":[{"text":"Pa