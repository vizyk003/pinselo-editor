{"name":"studio","opts":{"designId":"site-9","title":"studio & \"site\"","description":"Given <description>","noindex":true},"assetUrl":"https://cdn.example/api/assets/","html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>studio &amp; &quot;site&quot;</title>\n<meta name=\"description\" content=\"Given &lt;description&gt;\">\n<meta name=\"robots\" content=\"noindex\">\n<meta property=\"og:title\" content=\"studio &amp; &quot;site&quot;\">\n<meta property=\"og:description\" content=\"Given &lt;description&gt;\">\n\n<style>\n@font-face{font-family:\"Montserrat\";font-weight:700;font-style:normal;font-display:swap;src:url(\"/api/fonts/files/montserrat/Montserrat_700Bold.ttf\") format(\"truetype\")}\n@font-face{font-family:\"Lora\";font-weight:400;font-style:normal;font-display:swap;src:url(\"/api/fonts/files/lora/Lora_400Regular.ttf\") format(\"truetype\")}\n@font-face{font-family:\"Inter\";font-weight:700;font-style:normal;font-display:swap;src:url(\"/api/fonts/files/inter/Inter_700Bold.ttf\") format(\"truetype\")}\n@font-face{font-family:\"Inter\";font-weight:600;font-style:normal;font-display:swap;src:url(\"/api/fonts/files/inter/Inter_600SemiBold.ttf\") format(\"truetype\")}\n*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#fff;font-family:system-ui,sans-serif}\nnav.top{position:sticky;top:0;z-index:10;display:flex;gap:4px 18px;flex-wrap:wrap;justify-content:center;padding:12px 16px;background:rgba(255,255,255,.88);backdrop-filter:blur(10px);border-bottom:1px solid rgba(0,0,0,.06)}\nnav.top a{color:#111;text-decoration:none;font-weight:600;font-size:15px}nav.top a:hover{text-decoration:underline}\nsection{width:100%}.pg{position:relative;max-width:1366px;margin:0 auto}.pg>svg{display:block;width:100%;height:auto}\n.ov{position:absolute;inset:0}.ov>*{position:absolute}.lk{display:block}.em{border:0}.vd{object-fit:cover;background:#