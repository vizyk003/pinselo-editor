argin:0;flex:0 0 auto;width:auto;max-width:30%}.ri .mi{width:64px}\n.mf{display:grid;gap:12px}.mf .ft{font-size:18px}.mf label{display:grid;gap:6px;font-size:16px}.mf input,.mf textarea{font:inherit;font-size:16px;padding:10px 12px;color:inherit;width:100%}\n.mf fieldset{border:0;margin:0;padding:0;display:grid;gap:6px}.mf legend{font-size:16px;margin-bottom:4px}.mf .op{display:flex;gap:8px;align-items:center}.mf .op input{width:auto}\n.mf button{font:inherit;font-size:16px;font-weight:600;color:#fff;border:0;padding:12px 16px;cursor:pointer}.mf .hp{position:absolute;left:-9999px;width:1px;height:1px}.mf .bad{outline:2px solid #dc2626}.mf{position:relative}\n@media (max-width:699px){section.rf>.pg{display:none}section.rf>.m{display:block}}\n.badge{position:fixed;right:12px;bottom:12px;background:#fff;border:1px solid #e5e7eb;border-radius:999px;padding:6px 12px;font:600 12px system-ui;color:#111;text-decoration:none;box-shadow:0 2px 8px rgba(0,0,0,.08)}\n</style>\n</head>\n<body>\n<nav class=\"top\" aria-label=\"Sections\"><a href=\"#p1\">Home</a><a href=\"#p2\">Contact</a></nav>\n<main>\n<section id=\"p1\" aria-label=\"Home\" class=\"rf\" style=\"background:rgba(255,247,237,1)\"><div class=\"pg\"><div class=\"sr\"><h1>Light-filled homes, designed slowly</h1><p>We are a small architecture studio in Lisbon making calm, durable spaces for families and makers.</p><p>Book a visit</p><span role=\"img\" aria-label=\"A sunlit living room\"></span></div><svg aria-hidden=\"true\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1366 768\" width=\"1366\" height=\"768\"></svg><div class=\"ov\"><a class=\"lk\" style=\"left:5.8565%;top:54.6875%;width:17.5695%;height:8.3333%\" href=\"https://example.com/book\" target=\"_blank\" rel=\"noopener\" aria-label=\"Link\"></a></div></div><div class=\"m\" style=\"background:rgba(255,247,237,1)\"><div class=\"mc\"><h1 class=\"tx\" style=\"opacity:1\"><span class=\"pl\" style=\"text-align:start;line-height:1.3\"><span style=\"font-family:'Montserrat',system-ui,sans-serif;font-weight:700;font-size:34.2px;color:rgba(31,35,40,1)\">Light-filled homes, designed slowly</span></span></h1><div class=\"tx\" style=\"opacity:1\"><p style=\"text-align:start;line-height:1.3\"><span style=\"font-family:'Lora',system-ui,sans-serif;font-weight:400;font-size:14px;color:rgba(31,35,40,1)\">We are a small architecture studio in Lisbon making calm, durable spaces for families and makers.</span></p></div><a class=\"bk btn sm\" href=\"https://example.com/book\" target=\"_blank\" rel=\"noopener\" style=\"background:rgba(124,45,18,1);border-radius:19.2px\"><div class=\"bkc\"><div class=\"tx\" style=\"opacity:1\"><p style=\"text-align:center;line-height:1.3\"><span style=\"font-family:'Inter',system-ui,sans-serif;font-weight:700;font-size:14px;color:rgba(255,255,255,1)\">Book a visit</span></p></div></div></a><img class=\"mi\" style=\"width:100%;aspect-ratio:560/600;object-fit:cover;object-position:50% 50%;opacity:1\" src=\"https://cdn.example/api/assets/photo\" alt=\"A sunlit living room\" loading=\"lazy\" decoding=\"async\"><div class=\"mi\" aria-hidden=\"true\" style=\"width:19.3%;aspect-ratio:120/120\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"1180 600 120 120\" preserveAspectRatio=\"xMidYMid meet\" focusable=\"false\" style=\"overflow:visible\"></svg></div></div></div></section>\n<section id=\"p2\" aria-label=\"Contact\" class=\"rf\" style=\"background:linear-gradient(180deg,rgba(237,233,254,1) 0%,rgba(252,231,243,1) 100%)\"><div class=\"pg\"><div class=\"sr\"><h2>Say hello</h2></div><svg aria-hidden=\"true\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1366 768\" width=\"1366\" height=\"768\"></svg><div class=\"ov\"><form class=\"fm\" action=\"/api/forms/site-9/std0070000000000\" method=\"post\" aria-label=\"Contact us\" data-w=\"520\" data-s=\"18\" style=\"left:5.8565%;top:26.0417%;width:38.0673%;height:57.6563%;font-family:'Inter',sans-serif;color:rgba(31,35,40,1)\"><div class=\"fs\"></div><input name=\"name\" type=\"text\" aria-label=\"Name\" style=\"left:3.4615%;top:20.7317%;width:93.0769%;height:9.7561%\" required><input name=\"email\" type=\"email\" aria-label=\"Email\" style=\"left:3.4615%;top:41.0569%;width:93.0769%;height:9.7561%\" required><textarea name=\"message\" aria-label=\"Message\" style=\"left:3.4615%;top:61.3821%;width:93.0769%;height:20.3252%\"></textarea><button type=\"submit\" style=\"left:3.4615%;top:85.3659%;width:27.6923%;height:10.5691%\">Send</button><input name=\"_hp\" tabindex=\"-1\" autocomplete=\"off\" style=\"left:-9999px;top:0;width:1px;height:1px\" aria-hidden=\"true\"></form></div></div><div class=\"m\" style=\"background:linear-gradient(180deg,rgba(237,233,254,1) 0%,rgba(252,231,243,1) 100%)\"><div class=\"mc\"><h2 class=\"tx\" style=\"opacity:1\"><span class=\"pl\" style=\"text-align:start;line-height:1.3\"><span style=\"font-family:'Inter',system-ui,sans-serif;font-weight:700;font-size:29.9px;color:rgba(31,35,40,1)\">Say hello</span></span></h2><form class=\"mf\" action=\"/api/forms/site-9/std0070000000000\" method=\"post\" aria-label=\"Contact us\" style=\"font-family:'Inter',system-ui,sans-serif;color:rgba(31,35,40,1)\"><b class=\"ft\">Contact us</b><label>Name<input name=\"name\" type=\"text\" style=\"background:rgba(255,255,255,1);border:1px solid rgba(203,213,225,1);border-radius:8px\" required></label><label>Email<input name=\"email\" type=\"email\" style=\"background:rgba(255,255,255,1);border:1px solid rgba(203,213,225,1);border-radius:8px\" required></label><label>Message<textarea name=\"message\" rows=\"4\" style=\"background:rgba(255,255,255,1);border:1px solid rgba(203,213,225,1);border-radius:8px\"></textarea></label><button type=\"submit\" style=\"background:rgba(124,58,237,1);border-radius:8px\">Send</button><input name=\"_hp\" tabindex=\"-1\" autocomplete=\"off\" class=\"hp\" aria-hidden=\"true\"></form></div></div></section>\n</main>\n\n<script>\ndocument.querySelectorAll('form.fm,form.mf').forEach(function(f){\n  if(f.classList.contains('fm')){var fs=f.querySelector('.fs');\n  f.addEventListener('input',function(){fs.style.fontSize=(f.clientWidth/parseFloat(f.dataset.w)*parseFloat(f.dataset.s))+'px'});\n  function size(){f.style.fontSize=(f.clientWidth/parseFloat(f.dataset.w)*parseFloat(f.dataset.s)*0.85)+'px'}size();addEventListener('resize',size)}\n  f.addEventListener('submit',function(e){e.preventDefault();var d={};\n    f.querySelectorAll('[name]').forEach(function(i){if(i.type==='checkbox'){if(i.checked)(d[i.name]=d[i.name]||[]).push(i.value)}else if(i.type==='radio'){if(i.checked)d[i.name]=i.value}else d[i.name]=i.value});\n    fetch(f.action,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(d)}).then(function(r){return r.json().then(function(j){\n      f.querySelectorAll('.bad').forEach(function(x){x.classList.remove('bad')});\n      if(r.ok){var m=document.createElement('div');m.className='done';m.setAttribute('role','status');m.textContent=j.message||'Thanks!';f.appendChild(m)}\n      else Object.keys(j.problems||{}).forEach(function(k){var x=f.querySelector('[name=\"'+k+'\"]');if(x)x.classList.add('bad')})})})});\n});\n</script>\n</body>\n</html>","pages":[{"page":"pgstd00000000000","head":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1366 768\" width=\"1366\" height=\"768\">","faces":[{"family":"Montserrat","weight":700,"italic":false},{"family":"Montserrat","weight":700,"italic":false},{"family":"Lora","weight":400,"italic":false},{"family":"Lora","weight":400,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false}]},{"page":"pgstd10000000000","head":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1366 768\" width=\"1366\" height=\"768\">","faces":[{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700