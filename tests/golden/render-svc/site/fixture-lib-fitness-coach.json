ntent=j.message||'Thanks!';f.appendChild(m)}\n      else Object.keys(j.problems||{}).forEach(function(k){var x=f.querySelector('[name=\"'+k+'\"]');if(x)x.classList.add('bad')})})})});\n});\n</script>\n</body>\n</html>","pages":[{"page":"hMMMsCAwf6LsRciT","head":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1080 1920\" width=\"1080\" height=\"1920\">","faces":[{"family":"Archivo","weight":800,"italic":false},{"family":"Archivo","weight":800,"italic":false},{"family":"Anton","weight":400,"italic":false},{"family":"Anton","weight":400,"italic":false},{"family":"Archivo","weight":500,"italic":false},{"family":"Archivo","weight":500,"italic":false},{"family":"Archivo","weight":800,"italic":false},{"family":"Archivo","weight":800,"italic":false},{"family":"Archivo","weight":800,"italic":false},{"family":"Archivo","weight":800,"italic":false},{"family":"Archivo","weight":800,"italic":false},{"family":"Archivo","weight":800,"italic":false},{"family":"Archivo","weight":700,"italic":false},{"family":"Archivo","weight":700,"italic":false},{"family":"Archivo","weight":700,"italic":false},{"family":"Archivo","weight":700,"italic":false},{"family":"Archivo","weight":700,"italic":false},{"family":"Archivo","weight":700,"italic":false}]}],"picks":{"Anton|400|false":{"family":"Anton","weight":400,"italic":false,"file":"anton/Anton_400Regular.ttf"},"Archivo|500|false":{"family":"Archivo","weight":500,"italic":false,"file":"archivo/Archivo_500Medium.ttf"},"Archivo|700|false":{"family":"Archivo","weight":700,"italic":false,"file":"archivo/Archivo_700Bold.ttf"},"Archivo|800|false":{"family":"Archivo","weight":800,"italic":false,"file":"archivo/Archivo_800ExtraBold.ttf"}}}
