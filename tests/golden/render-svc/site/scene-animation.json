\n  f.addEventListener('submit',function(e){e.preventDefault();var d={};\n    f.querySelectorAll('[name]').forEach(function(i){if(i.type==='checkbox'){if(i.checked)(d[i.name]=d[i.name]||[]).push(i.value)}else if(i.type==='radio'){if(i.checked)d[i.name]=i.value}else d[i.name]=i.value});\n    fetch(f.action,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(d)}).then(function(r){return r.json().then(function(j){\n      f.querySelectorAll('.bad').forEach(function(x){x.classList.remove('bad')});\n      if(r.ok){if(window.__ocTrack)window.__ocTrack('form',f.getAttribute('aria-label')||'Form');var m=document.createElement('div');m.className='done';m.setAttribute('role','status');m.textContent=j.message||'Thanks!';f.appendChild(m)}\n      else Object.keys(j.problems||{}).forEach(function(k){var x=f.querySelector('[name=\"'+k+'\"]');if(x)x.classList.add('bad')})})})});\n});\n</script>\n</body>\n</html>","pages":[{"page":"pganm00000000000","head":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 1000\" width=\"1200\" height=\"1000\">","faces":[{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":700,"italic":false},{"family":"Inter","weight":400,"italic":false},{"family":"Inter