{if(window.__ocTrack)window.__ocTrack('form',f.getAttribute('aria-label')||'Form');var m=document.createElement('div');m.className='done';m.setAttribute('role','status');m.textContent=j.message||'Thanks!';f.appendChild(m)}\n      else Object.keys(j.problems||{}).forEach(function(k){var x=f.querySelector('[name=\"'+k+'\"]');if(x)x.classList.add('bad')})})})});\n});\n</script>\n</body>\n</html>","pages":[{"page":"5JqM2rP3JqL12meq","head":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1366 768\" width=\"1366\" height=\"768\">","faces":[{"family":"Bricolage Grotesque","weight":800,"italic":false},{"family":"Bricolage Grotesque","weight":800,"italic":false},{"family":"DM Sans","weight":500,"italic":false},{"family":"DM Sans","weight":500,"italic":false},{"family":"DM Sans","weight":500,"italic":false},{"family":"DM Sans","weight":500,"italic":false},{"family":"DM Sans","weight":500,"italic":false},{"family":"DM Sans","weight":500,"italic":false},{"family":"DM Sans","weight":700,"italic":false},{"family":"DM Sans","weight":700,"italic":false},{"family":"DM Sans","weight":700,"italic":false},{"family":"DM Sans","weight":700,"italic":false},{"family":"Bricolage Grotesque","weight":800,"italic":false},{"family":"Bricolage Grotesque","weight":800,"italic":false},{"family":"DM Sans","weight":400,"italic":false},{"family":"DM Sans","weight":400,"italic":false},{"family":"DM Sans","weight":700,"italic":false},{"family":"DM Sans","weight":700,"italic":false},{"family":"DM Sans","weight":600,"italic":false},{"family":"DM Sans","weight":600,"italic":false},{"family":"DM Sans","weight":500,"italic":false},{"family":"DM Sans","weight":500,"italic":false},{"family":"Noto Sans Symbols 2","weight":500,"italic":false},{"family":"Bricolage Grotesque","weight":800,"italic":false},{"family":"Bricolage Grotesque","weight":800,"italic":false},{"family":"DM Sans","weight":400,"italic":false},{"family":"DM Sans","weight":400,"italic":false}]},{"page":"dqXhnXssowW9zBFJ","head":"<svg xm