{
  "name": "@oc/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Browser bridge to the Pinselo Rust core (crates/oc-wasm): editor, schema, geometry, CRDT, text, sheet and renderer, with the document types in src/types",
  "exports": {
    ".": "./src/index.ts",
    "./lazy": "./src/api.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run --config vitest.config.ts",
    "bench": "vitest run --config vitest.config.ts test/bench.test.ts",
    "bench:render": "tsx scripts/bench-render.mts"
  },
  "dependencies": {
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "binaryen": "132.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
